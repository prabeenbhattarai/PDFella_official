{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFella",
  "version": "0.1.3",
  "identifier": "com.pdfella.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Edit, convert and sign PDFs",
    "longDescription": "PDFella on your desktop: edit PDF text, sign, merge, split, compress and convert documents. Needs an internet connection.",
    "copyright": "\u00a9 PDFella",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pdfella"
        ]
      }
    }
  }
}

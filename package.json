{
  "name": "pdfella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:dev": "cd services/worker && APP_SECRET=${APP_SECRET:-dev-local-secret-0123456789} .venv/bin/uvicorn worker.app:app --host 127.0.0.1 --port 8080 --reload",
    "worker:test": "cd services/worker && .venv/bin/python -m pytest -q",
    "fixtures": "node scripts/make-fixtures.mjs",
    "sample": "node scripts/make-sample.mjs",
    "guides": "node scripts/make-guide-fixtures.mjs && node scripts/capture-guides.mjs"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.2.1",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "firebase-admin": "^14.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}

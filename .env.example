# ── Public
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Server (Next.js API)
APP_URL=https://your-domain.com
# Long random string; shared with the worker. Signs job tokens, local URLs and worker callbacks.
APP_SECRET=
# Bearer token for /api/cleanup (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=
# How long server-side jobs and files may live (minutes).
JOB_TTL_MINUTES=60

# ── Processing backend (leave WORKER_URL empty to run browser-only)
WORKER_URL=
STORAGE_BACKEND=local          # gcs | local
JOBS_BACKEND=memory            # firestore | memory
QUEUE_BACKEND=direct           # cloudtasks | direct
LOCAL_DATA_DIR=.data

# ── Google Cloud / Firebase (when using gcs/firestore/cloudtasks)
GCP_PROJECT=
STORAGE_BUCKET=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=pdf-jobs
WORKER_INVOKER_SA=

# ── Analytics (PostHog; leave empty to disable). Use an EU project and turn on
# cookieless mode in its settings. POSTHOG_HOST only changes for a US project.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# ── Public API (services/public-api). The website only needs the URL for the /developers page.
NEXT_PUBLIC_API_URL=https://api.pdfella.com
# For the API service itself:
API_KEYS_BACKEND=file          # firestore | file
API_DATA_DIR=.data

# ── Search engines (set once the production domain is live)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
